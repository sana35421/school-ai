# 校园智能问答助手生产环境变量示例
# 复制为 .env 后填写真实值；不要把 .env 提交到 Git。

MYSQL_PASSWORD=change-this-to-a-long-random-password
DIFY_SECRET_KEY=change-this-to-a-long-random-secret
DIFY_INIT_PASSWORD=change-this-to-a-strong-admin-password
DIFY_API_KEY=app-replace-with-your-dify-app-key
JWT_SECRET=change-this-to-at-least-32-random-characters
YIBAN_LOGIN_ENABLED=false
YIBAN_TEST_STUDENT_ID=yiban_test

# 业务后端访问已部署 Dify API 的地址
DIFY_API_BASE=http://dify-api:5001/v1
CHAT_FILE_UPLOAD_ENABLED=true

# Optional: knowledge-base fallback web search. Keep disabled until Bocha is configured.
WEB_SEARCH_ENABLED=false
BOCHA_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12
# Comma-separated trusted domains, for example: edu.cn,moe.gov.cn,ccpc.io
WEB_SEARCH_ALLOWED_DOMAINS=
