# 校园智能问答助手生产环境变量示例
# 复制为 .env 后填写真实值；不要把 .env 提交到 Git。

MYSQL_PASSWORD=change-this-to-a-long-random-password
DIFY_SECRET_KEY=change-this-to-a-long-random-secret
DIFY_INIT_PASSWORD=change-this-to-a-strong-admin-password
DIFY_API_KEY=app-replace-with-your-dify-app-key
JWT_SECRET=change-this-to-at-least-32-random-characters

# 业务后端访问已部署 Dify API 的地址
DIFY_API_BASE=http://dify-api:5001/v1
